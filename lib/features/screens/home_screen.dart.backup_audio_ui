  final bool fromUser;
  final String? id;
  final String? chatId;

  const ChatMessage({
    required this.text,
    required this.fromUser,
    this.id,
    this.chatId,
  });
}

class PendingAttachment {
  final String name;
  final String content;
  final int sizeBytes;

  const PendingAttachment({
    required this.name,
    required this.content,
    required this.sizeBytes,
  });
}


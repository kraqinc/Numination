<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/numination_bg"
    android:padding="24dp">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:background="@drawable/splash_logo_backplate"
        android:contentDescription="@string/app_name"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:src="@drawable/numination_logo_wordmark" />

    <View
        android:id="@+id/claudeDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="center"
        android:background="@drawable/claude_dot" />

</FrameLayout>

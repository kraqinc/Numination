# Supabase hosted SMTP via Brevo. IMPORTANT: password must be a Brevo SMTP key,
# not a Brevo API key. These vars are also consumed by the local Supabase
# config and by scripts/configure-supabase-smtp.sh.
SUPABASE_SMTP_HOST="smtp-relay.brevo.com"
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASSWORD=
SUPABASE_SMTP_ADMIN_EMAIL=
SUPABASE_SMTP_SENDER_NAME="Numination"
SUPABASE_AUTH_REDIRECT_URL="numination://auth"

# Management API token used ONLY by the optional SMTP configuration script.
SUPABASE_ACCESS_TOKEN=

# AI
GEMINI_API_KEY=

# App version
